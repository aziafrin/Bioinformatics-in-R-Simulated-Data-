# Example: longitudinal biomarker measurements
# =============================================
# Generate synthetic biomarker_time_series.csv
# =============================================

set.seed(123)

# Parameters
n_patients <- 12
n_timepoints <- 5
timepoints <- c("T0", "T1", "T2", "T3", "T4")

# Create patient IDs and time points
patients <- rep(paste0("P", sprintf("%02d", 1:n_patients)), each = n_timepoints)
time <- rep(timepoints, times = n_patients)

# Simulate condition (6 control, 6 treated)
condition <- rep(c("control", "treated"), each = n_patients/2 * n_timepoints)

# Simulate biomarker values (e.g., a inflammation or disease biomarker)
# Base level + time trend + treatment effect + random noise + patient effect
base <- 100
time_effect <- c(0, 5, 15, 25, 30)          # increasing over time
treatment_effect <- ifelse(condition == "treated", 40, 0)

patient_effect <- rep(rnorm(n_patients, mean = 0, sd = 15), each = n_timepoints)

biomarker_value <- base + 
  rep(time_effect, times = n_patients) + 
  treatment_effect + 
  patient_effect + 
  rnorm(n_patients * n_timepoints, mean = 0, sd = 12)

# Create the data frame
biomarker_ts <- data.frame(
  patient_id = patients,
  timepoint  = time,
  condition  = condition,
  biomarker_value = round(biomarker_value, 2),
  date       = as.Date("2025-01-01") + rep(0:(n_timepoints-1)*7, times = n_patients)  # weekly measurements
)

# Save it as CSV (so you can read it later)
write.csv(biomarker_ts, "biomarker_time_series.csv", row.names = FALSE)

# Check the data
head(biomarker_ts)
str(biomarker_ts)
table(biomarker_ts$timepoint, biomarker_ts$condition)







biomarker_ts <- read.csv("biomarker_time_series.csv")

head(biomarker_ts)

# Suppose columns: date, patient_id, biomarker_value
biomarker_ts$date <- as.Date(biomarker_ts$date)

# Aggregate mean biomarker value by date
daily_signal <- biomarker_ts %>%
  group_by(date) %>%
  summarise(mean_value = mean(biomarker_value, na.rm = TRUE)) %>%
  arrange(date)

ggplot(daily_signal, aes(x = date, y = mean_value)) +
  geom_line() +
  labs(
    title = "Average Biomarker Signal Over Time",
    x = "Date",
    y = "Mean Biomarker Value"
  )

# Convert to time series object
signal_ts <- ts(daily_signal$mean_value, frequency = 7)

# Decomposition
signal_decomp <- stl(signal_ts, s.window = "periodic")
plot(signal_decomp)

# Automatic ARIMA model
fit_arima <- auto.arima(signal_ts)
summary(fit_arima)

# Forecast next 14 periods
signal_forecast <- forecast(fit_arima, h = 14)
plot(signal_forecast)



